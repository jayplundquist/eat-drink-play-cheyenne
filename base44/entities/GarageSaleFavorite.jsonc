{
  "name": "GarageSaleFavorite",
  "type": "object",
  "properties": {
    "garage_sale_id": {
      "type": "string",
      "description": "ID of the saved garage sale"
    },
    "garage_sale_title": {
      "type": "string",
      "description": "Snapshot of the sale title for display"
    }
  },
  "required": [
    "garage_sale_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}