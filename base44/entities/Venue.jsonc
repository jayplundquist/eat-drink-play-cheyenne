{
  "name": "Venue",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the venue"
    },
    "slug": {
      "type": "string",
      "description": "Auto-generated URL-friendly slug for SEO (e.g. 'luxury-diner-cheyenne')"
    },
    "manual_slug": {
      "type": "string",
      "description": "Optional admin override for the URL slug"
    },
    "primary_category": {
      "type": "string",
      "description": "The category used for the URL structure (e.g. 'restaurant')"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "restaurant",
          "bar",
          "brewery",
          "music_hall",
          "activity",
          "recreation",
          "souvenir_shopping",
          "food_trucks"
        ]
      },
      "description": "Types of venue"
    },
    "description": {
      "type": "string",
      "description": "Description of the venue"
    },
    "address": {
      "type": "string",
      "description": "Street address"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "price_range": {
      "type": "string",
      "enum": [
        "Free",
        "$",
        "$$",
        "$$$",
        "$$$$"
      ]
    },
    "hours": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "food_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "asian",
          "international",
          "mexican",
          "american",
          "steaks",
          "bbq",
          "dessert",
          "fine_dining",
          "pizza"
        ]
      },
      "description": "Types of food served (for restaurants)"
    },
    "claimed_by": {
      "type": "string",
      "description": "Email of the user who claimed this venue"
    },
    "lat": {
      "type": "number",
      "description": "Latitude of the venue (for map display)"
    },
    "lng": {
      "type": "number",
      "description": "Longitude of the venue (for map display)"
    },
    "is_live": {
      "type": "boolean",
      "default": false,
      "description": "Chuck wagons only: vendor has tapped 'We're serving' and is open right now"
    },
    "live_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the live pin was last refreshed. The public map treats anything older than 6 hours as stale, regardless of is_live"
    },
    "live_lat": {
      "type": "number",
      "description": "Chuck wagons only: current location latitude, separate from lat so a home base is not overwritten"
    },
    "live_lng": {
      "type": "number",
      "description": "Chuck wagons only: current location longitude"
    },
    "live_location_label": {
      "type": "string",
      "description": "Chuck wagons only: friendly place name for the current stop, e.g. 'Depot Plaza'"
    },
    "live_note": {
      "type": "string",
      "description": "Chuck wagons only: short note for today, e.g. 'Cash only' or 'Out of brisket'"
    },
    "live_open_until": {
      "type": "string",
      "format": "date-time",
      "description": "Chuck wagons only: optional closing time for the current stop"
    },
    "pin_logo_url": {
      "type": "string",
      "description": "Logo image used as the map pin when has_branded_pin is true"
    },
    "has_branded_pin": {
      "type": "boolean",
      "default": false,
      "description": "Paid upgrade: render pin_logo_url as the map pin instead of the default letter pin"
    },
    "total_ratings": {
      "type": "number",
      "default": 0
    },
    "rating_sum": {
      "type": "number",
      "default": 0
    },
    "rating_count": {
      "type": "number",
      "default": 0
    },
    "quick_draw_boost": {
      "type": "boolean",
      "default": false,
      "description": "Premium boost for Quick Draw selection"
    },
    "boost_expires_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the Quick Draw boost expires"
    },
    "menu_pictures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of menu pictures"
    },
    "locked_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of field names locked by admins",
      "default": []
    },
    "has_big_boot": {
      "type": "boolean",
      "default": false,
      "description": "Whether this venue has one of the 29 iconic Big Boots"
    },
    "critter_friendly": {
      "type": "boolean",
      "default": false,
      "description": "Whether this venue is pet/critter friendly"
    },
    "veteran_owned": {
      "type": "boolean",
      "default": false,
      "description": "Whether this venue is veteran owned"
    },
    "broadcasts_superbowl": {
      "type": "boolean",
      "default": false,
      "description": "Whether this venue broadcasts the Super Bowl"
    },
    "permanently_closed": {
      "type": "boolean",
      "default": false,
      "description": "Whether this venue is permanently closed"
    },
    "last_synced_date": {
      "type": "string",
      "format": "date-time",
      "description": "When venue info was last auto-synced from Google"
    },
    "sync_error": {
      "type": "string",
      "description": "Error message from the last failed sync attempt (cleared on success)"
    },
    "last_sync_changes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Field names actually changed during the last sync",
      "default": []
    }
  },
  "required": [
    "name",
    "categories"
  ]
}